<h1>Enquiries</h1>

<div class="field-row" style="margin-bottom:1rem;">
  <a href="/admin/enquiries" class="pill <%= !activeStatus ? 'active' : '' %>">All</a>
  <% ['new', 'contacted', 'archived'].forEach(function (s) { %>
    <a href="/admin/enquiries?status=<%= s %>" class="pill <%= activeStatus === s ? 'active' : '' %>"><%= s %></a>
  <% }); %>
</div>

<table class="admin-table">
  <thead><tr><th>Name</th><th>Contact</th><th>Message</th><th>Page / Lang</th><th>When</th><th>Status</th></tr></thead>
  <tbody>
    <% enquiries.forEach(function (e) { %>
      <tr>
        <td><%= e.name %></td>
        <td><%= e.phone || '' %><% if (e.phone && e.email) { %><br><% } %><%= e.email || '' %></td>
        <td style="max-width:280px;"><%= e.message %></td>
        <td><%= e.source_page %> / <%= e.locale %></td>
        <td><%= new Date(e.created_at).toLocaleString() %></td>
        <td>
          <form method="POST" action="/admin/enquiries/<%= e.id %>/status">
            <select name="status" onchange="this.form.submit()">
              <% ['new', 'contacted', 'archived'].forEach(function (s) { %>
                <option value="<%= s %>" <%= e.status === s ? 'selected' : '' %>><%= s %></option>
              <% }); %>
            </select>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<h1>Media Library</h1>

<div class="panel">
  <h2 style="margin-top:0;font-size:1rem;">Upload an image</h2>
  <form method="POST" action="/admin/media/upload" enctype="multipart/form-data">
    <div class="field-row">
      <div class="field">
        <label for="image">Image file (JPEG, PNG or WebP)</label>
        <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" required>
      </div>
      <div class="field">
        <label for="group">Group</label>
        <select id="group" name="group">
          <% groups.forEach(function (g) { %><option value="<%= g %>"><%= g %></option><% }); %>
        </select>
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="alt_en">Alt text / caption (English)</label>
        <input type="text" id="alt_en" name="alt_en" placeholder="Describe what's in the photo">
      </div>
      <div class="field">
        <label for="alt_vi">Alt text / caption (Vietnamese)</label>
        <input type="text" id="alt_vi" name="alt_vi">
      </div>
    </div>
    <p class="field-hint">For photos tagged <strong>product_collection</strong>, this text is also shown as a visible caption line under the photo on the Our Garments page — e.g. "Unlined jacket, tropical wool, half-canvassed finish." For other groups it's just accessibility/SEO alt text and isn't shown on the page.</p>
    <button type="submit" class="btn">Upload &amp; Resize</button>
  </form>
</div>

<div class="field-row" style="margin-bottom:1rem;">
  <a href="/admin/media" class="pill <%= !activeGroup ? 'active' : '' %>">All</a>
  <% groups.forEach(function (g) { %>
    <a href="/admin/media?group=<%= g %>" class="pill <%= activeGroup === g ? 'active' : '' %>"><%= g %></a>
  <% }); %>
</div>

<div class="media-grid">
  <% media.forEach(function (m) { %>
    <figure>
      <img src="<%= m.variants && m.variants.webp ? Object.values(m.variants.webp)[0] : '' %>" alt="<%= m.alt_en %>">
      <figcaption>
        <div><%= m.filename %></div>
        <div><%= m.width %>×<%= m.height %></div>
        <form method="POST" action="/admin/media/<%= m.id %>/group" style="margin-top:0.3rem;display:flex;gap:0.25rem;">
          <select name="group" style="font-size:0.75rem;padding:0.2rem;flex:1;min-width:0;">
            <% groups.forEach(function (g) { %>
              <option value="<%= g %>" <%= m.group === g ? 'selected' : '' %>><%= g %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn--ghost btn" style="padding:0.15rem 0.4rem;font-size:0.7rem;flex-shrink:0;">Save group</button>
        </form>
        <div style="margin-top:0.3rem;">
          <% if (m.original_path) { %>
            <a href="<%= m.original_path %>" target="_blank" style="font-size:0.75rem;">Original ↓</a>
            &nbsp;·&nbsp;
          <% } %>
          <a href="/admin/media/<%= m.id %>/focal-point" style="font-size:0.75rem;">Focus point</a>
        </div>

        <form method="POST" action="/admin/media/<%= m.id %>/alt" style="margin-top:0.4rem;">
          <input type="text" name="alt_en" value="<%= m.alt_en || '' %>" placeholder="Caption (EN)" style="width:100%;font-size:0.75rem;padding:0.3rem;margin-bottom:0.25rem;">
          <input type="text" name="alt_vi" value="<%= m.alt_vi || '' %>" placeholder="Caption (VI)" style="width:100%;font-size:0.75rem;padding:0.3rem;margin-bottom:0.25rem;">
          <button type="submit" class="btn--ghost btn" style="padding:0.15rem 0.4rem;font-size:0.7rem;">Save caption</button>
        </form>

        <form method="POST" action="/admin/media/<%= m.id %>/delete" onsubmit="return confirm('Delete this image? This cannot be undone — including the original file.');" style="margin-top:0.4rem;">
          <button type="submit" class="btn--ghost btn" style="padding:0.15rem 0.4rem;font-size:0.7rem;">Delete</button>
        </form>
      </figcaption>
    </figure>
  <% }); %>
</div>

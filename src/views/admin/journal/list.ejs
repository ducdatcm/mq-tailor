<div class="admin-topbar">
  <h1 style="margin:0;">Journal</h1>
  <a class="btn" href="/admin/journal/new">+ New Post</a>
</div>

<table class="admin-table">
  <thead><tr><th>Title (EN)</th><th>Category</th><th>Status</th><th>Published</th><th></th></tr></thead>
  <tbody>
    <% posts.forEach(function (p) { %>
      <tr>
        <td><%= p.title_en %></td>
        <td><%= p.category %></td>
        <td><span class="tag <%= p.status === 'published' ? 'tag--live' : '' %>"><%= p.status %></span></td>
        <td><%= p.published_at ? new Date(p.published_at).toLocaleDateString() : '—' %></td>
        <td>
          <a href="/admin/journal/<%= p.id %>/edit">Edit</a>
          &nbsp;·&nbsp;
          <form method="POST" action="/admin/journal/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this post?');">
            <button type="submit" class="btn--ghost btn" style="padding:0.2rem 0.5rem;font-size:0.8rem;">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

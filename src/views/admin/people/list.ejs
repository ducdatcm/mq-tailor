<div class="admin-topbar">
  <h1 style="margin:0;">People</h1>
  <a class="btn" href="/admin/people/new">+ New Person</a>
</div>

<table class="admin-table">
  <thead><tr><th>Name</th><th>Section</th><th>Role (EN)</th><th>Order</th><th>Active</th><th></th></tr></thead>
  <tbody>
    <% people.forEach(function (p) { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= GROUPS[p.group_key] || p.group_key %></td>
        <td><%= p.role_en %></td>
        <td><%= p.sort_order %></td>
        <td><span class="tag <%= p.active ? 'tag--live' : '' %>"><%= p.active ? 'Active' : 'Hidden' %></span></td>
        <td>
          <a href="/admin/people/<%= p.id %>/edit">Edit</a>
          &nbsp;·&nbsp;
          <form method="POST" action="/admin/people/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Remove this person?');">
            <button type="submit" class="btn--ghost btn" style="padding:0.2rem 0.5rem;font-size:0.8rem;">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<h1><%= mill ? 'Edit Mill' : 'New Mill' %></h1>

<form method="POST" action="<%= mill ? '/admin/cloth/' + mill.id + '/edit' : '/admin/cloth/new' %>">
  <div class="panel">
    <div class="field">
      <label for="name">Mill name</label>
      <input type="text" id="name" name="name" required value="<%= mill ? mill.name : '' %>">
    </div>
    <div class="field-row">
      <div class="field">
        <label for="description_en">Short note (English)</label>
        <input type="text" id="description_en" name="description_en" value="<%= mill ? mill.description_en || '' : '' %>">
      </div>
      <div class="field">
        <label for="description_vi">Short note (Vietnamese)</label>
        <input type="text" id="description_vi" name="description_vi" value="<%= mill ? mill.description_vi || '' : '' %>">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="sort_order">Sort order</label>
        <input type="number" id="sort_order" name="sort_order" value="<%= mill ? mill.sort_order : 0 %>">
      </div>
      <div class="field">
        <label><input type="checkbox" name="active" <%= !mill || mill.active ? 'checked' : '' %> style="width:auto;"> Visible on the site</label>
      </div>
    </div>
    <div class="field">
      <label for="media_id">Logo or reference photo</label>
      <select id="media_id" name="media_id" onchange="document.getElementById('crop-link-mill').style.display = this.value ? 'inline' : 'none'; document.getElementById('crop-link-mill').href = '/admin/media/' + this.value + '/focal-point';">
        <option value="">— None —</option>
        <% media.forEach(function (m) { %>
          <option value="<%= m.id %>" <%= mill && mill.media_id === m.id ? 'selected' : '' %>><%= m.filename %> (<%= m.group %>)</option>
        <% }); %>
      </select>
      <p class="field-hint">Upload the logo/photo from the <a href="/admin/media">Media Library</a> first (Group "cloth" works well) — it'll show up in this list.
        <a
          id="crop-link-mill"
          href="/admin/media/<%= (mill && mill.media_id) || '' %>/focal-point"
          style="display:<%= mill && mill.media_id ? 'inline' : 'none' %>;"
        > · Adjust crop / focus point ↗</a>
      </p>
    </div>
  </div>
  <button type="submit" class="btn">Save</button>
  <a href="/admin/cloth" class="btn btn--ghost">Cancel</a>
</form>

<%- include('../partials/intro-header', { headingKey: 'people.heading', intro: content.intro }) %>

<% groups.forEach(function (group, i) { %>
  <section class="section <%= i % 2 === 1 ? 'section--alt' : '' %> reveal">
    <div class="container">
      <% if (group.intro) { %>
        <div class="container--narrow" style="margin-bottom:2.5rem;padding-inline:0;">
          <span class="eyebrow"><%= group.intro['title_' + lang] %></span>
          <h2><%= group.intro['title_' + lang] %></h2>
          <p class="lede"><%= group.intro['body_' + lang] %></p>
        </div>
      <% } %>

      <% if (group.people.length) { %>
        <div class="grid grid--4">
          <% group.people.forEach(function (person) { %>
            <div class="card">
              <div class="media-frame">
                <%- include('../partials/image', { media: person.photo, alt: person.name, ratio: '3/4' }) %>
              </div>
              <h3 class="card__title"><%= person.name %></h3>
              <p class="card__meta"><%= person['role_' + lang] %></p>
              <p class="text-muted" style="font-size:0.9rem;"><%= person['bio_' + lang] %></p>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>
<% }); %>

<% if (gallery && gallery.length) { %>
<section class="section reveal">
  <div class="container">
    <h2 style="font-size:var(--fs-xl);margin-bottom:2rem;"><%= t('people.gallery_heading') %></h2>
    <div class="grid grid--4">
      <% gallery.forEach(function (photo) { %>
        <div class="media-frame">
          <%- include('../partials/image', { media: photo, ratio: '4/5' }) %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

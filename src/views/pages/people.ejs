<section class="section container container--narrow reveal">
  <span class="eyebrow"><%= t('people.heading') %></span>
  <h1><%= t('people.heading') %></h1>
  <p class="lede"><%= content.intro ? content.intro['body_' + lang] : '' %></p>
</section>

<section class="section section--alt">
  <div class="container grid grid--4">
    <% people.forEach(function (person) { %>
      <div class="card reveal">
        <div class="media-frame">
          <%- include('../partials/image', { media: person.photo, alt: person.name, ratio: '3/4' }) %>
        </div>
        <h3 class="card__title"><%= person.name %></h3>
        <p class="card__meta"><%= person['role_' + lang] %></p>
        <p class="text-muted" style="font-size:0.9rem;"><%= person['bio_' + lang] %></p>
      </div>
    <% }); %>
  </div>
</section>

<%- include('../partials/intro-header', { headingKey: 'cloth.heading', intro: content.intro }) %>

<% var millLogos = (mills || []).filter(function (m) { return m.photo; }); %>
<section class="section section--alt reveal">
  <div class="container">
    <% if (millLogos.length) { %>
      <div class="slider slider--logos" data-slider>
        <div class="slider__track">
          <% millLogos.forEach(function (mill) { %>
            <div class="slider__item slider__item--logo" title="<%= mill['description_' + lang] || mill.name %>">
              <%- include('../partials/image', { media: mill.photo, alt: mill.name }) %>
            </div>
          <% }); %>
        </div>
        <% if (millLogos.length > 5) { %>
          <div class="slider__controls">
            <button type="button" class="slider__btn" data-slider-prev aria-label="<%= t('cta.previous') %>">‹</button>
            <button type="button" class="slider__btn" data-slider-next aria-label="<%= t('cta.next') %>">›</button>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="text-muted text-center"><%= t('cloth.mills_empty') %></p>
    <% } %>
  </div>
</section>

<% if (gallery && gallery.length) { %>
<section class="section reveal">
  <div class="container">
    <h2 style="font-size:var(--fs-xl);margin-bottom:2rem;"><%= t('cloth.gallery_heading') %></h2>
    <div class="grid grid--4">
      <% gallery.forEach(function (photo) { %>
        <div class="media-frame">
          <%- include('../partials/image', { media: photo, ratio: '1/1' }) %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section text-center reveal">
  <div class="container container--narrow">
    <a class="btn" href="/<%= lang %>/visit"><%= t('cta.visit_the_house') %></a>
  </div>
</section>

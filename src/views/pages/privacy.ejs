<%
  var vi = lang === 'vi';

  var copy = vi ? {
    updated: 'Cập nhật lần cuối',
    lede: 'Ngắn gọn: chúng tôi chỉ dùng thông tin bạn gửi để trả lời bạn.',
    contactHeading: 'Liên hệ về dữ liệu cá nhân',
    address: 'Địa chỉ', email: 'Email', phone: 'Điện thoại',
    sections: [
      { h: 'Chúng tôi là ai',
        p: ['Website của Nhà May Minh Quang do ' + companyName + ' vận hành. Chính sách này chỉ áp dụng cho website.'],
        contact: true },
      { h: 'Chúng tôi thu thập gì và để làm gì',
        p: ['Khi bạn gửi biểu mẫu liên hệ ở trang Ghé Thăm, chúng tôi nhận họ tên, số điện thoại hoặc email, ngày giờ bạn muốn đến (nếu bạn chọn), và nội dung tin nhắn. Chúng tôi dùng những thông tin này để trả lời và hẹn lịch với bạn, dựa trên sự đồng ý bạn đã tích chọn. Chúng tôi không dùng chúng để tiếp thị và không bán cho ai.'] },
      { h: 'Ai được xem',
        p: ['Chỉ nhân viên trả lời liên hệ, và các dịch vụ chúng tôi dùng để vận hành website và gửi email; một số dịch vụ này có máy chủ ở nước ngoài. Bản đồ và phông chữ trên website do Google cung cấp, nên Google có thể nhận địa chỉ IP của bạn khi chúng được tải.'] },
      { h: 'Lưu trong bao lâu',
        p: ['Tối đa 24 tháng sau lần liên hệ cuối cùng, rồi xóa. Bạn có thể yêu cầu xóa sớm hơn.'] },
      { h: 'Cookie',
        p: ['Website chỉ dùng cookie Google Analytics nếu bạn bấm Đồng ý ở banner cookie. Các cookie này cho chúng tôi biết khách xem những trang nào, đến từ đâu (ví dụ từ Google Maps) và dùng thiết bị gì. Dữ liệu do Google xử lý và có thể được lưu ở nước ngoài. Nếu bạn từ chối hoặc chưa chọn, Google Analytics không được tải. Bạn có thể đổi ý bất cứ lúc nào qua mục Cài đặt cookie ở cuối trang. Website không dùng cookie quảng cáo.', 'Ngoài ra chúng tôi lưu một cookie nhỏ (mq_consent) để nhớ lựa chọn của bạn trong 6 tháng.'] },
      { h: 'Quyền của bạn',
        p: ['Theo Luật Bảo vệ dữ liệu cá nhân (Luật số 91/2025/QH15), bạn có thể xem, sửa, xóa dữ liệu của mình, hạn chế hoặc phản đối việc sử dụng, và rút lại sự đồng ý bất cứ lúc nào. Hãy liên hệ theo thông tin ở trên. Chúng tôi xác nhận đã nhận yêu cầu trong 2 ngày làm việc và xử lý trong 10 đến 20 ngày tùy loại yêu cầu.'] },
      { h: 'Khiếu nại và thay đổi',
        p: ['Nếu chưa hài lòng, bạn có thể khiếu nại với cơ quan bảo vệ dữ liệu cá nhân (thuộc Bộ Công an). Khi chính sách thay đổi, ngày ở đầu trang sẽ được cập nhật.'] }
    ]
  } : {
    updated: 'Last updated',
    lede: 'In short: we only use what you send us to reply to you.',
    contactHeading: 'Contact for privacy questions',
    address: 'Address', email: 'Email', phone: 'Phone',
    sections: [
      { h: 'Who we are',
        p: ['The Minh Quang Tailoring House website is operated by ' + companyName + '. This policy covers this website only.'],
        contact: true },
      { h: 'What we collect, and why',
        p: ['When you send the enquiry form on the Visit page, we receive your name, your phone number or email, your preferred visit date and time (if you choose one), and your message. We use them to reply to you and arrange a visit, based on the consent you give by ticking the box. We don’t use them for marketing and we don’t sell them.'] },
      { h: 'Who sees it',
        p: ['Only our staff who answer enquiries, and the services we use to run this website and send email; some of these keep data on servers outside Vietnam. The map and fonts on this site come from Google, which may receive your IP address when they load.'] },
      { h: 'How long we keep it',
        p: ['Up to 24 months after our last contact with you, then we delete it. You can ask us to delete it sooner.'] },
      { h: 'Cookies',
        p: ['This website uses Google Analytics cookies only if you press Accept in the cookie banner. They tell us which pages visitors read, how they found us (for example from Google Maps) and what kind of device they use. The data is processed by Google and may be stored outside Vietnam. If you decline, or haven’t chosen yet, Google Analytics is not loaded. You can change your mind any time with Cookie settings at the bottom of every page. We use no advertising cookies.', 'We also keep one small cookie (mq_consent) to remember your choice for 6 months.'] },
      { h: 'Your rights',
        p: ['Under Vietnam’s Personal Data Protection Law (Law No. 91/2025/QH15), you can see, correct or delete your data, limit or object to how we use it, and withdraw your consent at any time. Contact us using the details above. We confirm we received your request within 2 working days and handle it within 10 to 20 days, depending on the request.'] },
      { h: 'Complaints and changes',
        p: ['If you are not satisfied, you can complain to Vietnam’s personal data protection authority (under the Ministry of Public Security). If this policy changes, the date at the top will change too.'] }
    ]
  };
%>
<section class="section section--alt">
  <div class="container container--narrow text-center">
    <h1><%= t('footer.privacy') %></h1>
    <p class="lede" style="margin-inline:auto;"><%= copy.lede %></p>
    <p class="text-muted" style="font-size:var(--fs-sm);margin-bottom:0;"><%= copy.updated %>: <%= updated %></p>
  </div>
</section>

<section class="section policy">
  <div class="container container--narrow">
    <% copy.sections.forEach(function (s) { %>
      <h2><%= s.h %></h2>
      <% s.p.forEach(function (para) { %><p><%= para %></p><% }); %>
      <% if (s.contact) { %>
        <div class="policy__contact">
          <strong><%= copy.contactHeading %></strong>
          <% if (settings && settings.address_line) { %><span><%= copy.address %>: <%= settings.address_line %></span><% } %>
          <% if (settings && settings.email) { %><span><%= copy.email %>: <a href="mailto:<%= settings.email %>"><%= settings.email %></a></span><% } %>
          <% if (settings && settings.phone) { %><span><%= copy.phone %>: <%= settings.phone %></span><% } %>
        </div>
      <% } %>
    <% }); %>
  </div>
</section>

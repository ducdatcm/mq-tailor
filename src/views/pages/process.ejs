<%- include('../partials/intro-header', { headingKey: 'process.heading', intro: content.intro }) %>

<section class="section section--alt">
  <div class="container">
    <ol class="process-list" style="list-style:none;padding:0;">
      <% steps.forEach(function (step, i) { %>
        <li class="process-step reveal">
          <span class="process-step__number"><%= String(i + 1).padStart(2, '0') %></span>
          <div>
            <h3><%= step['title_' + lang] %></h3>
            <% paragraphs(step['body_' + lang]).forEach(function (para) { %>
              <p class="text-muted"><%= para %></p>
            <% }); %>
          </div>
          <div class="media-frame">
            <%- include('../partials/image', { media: step.media, alt: step['title_' + lang], ratio: '4/3' }) %>
          </div>
        </li>
      <% }); %>
    </ol>
  </div>
</section>

<% if (gallery && gallery.length) { %>
<section class="section reveal">
  <div class="container">
    <h2 style="font-size:var(--fs-xl);margin-bottom:2rem;"><%= t('process.gallery_heading') %></h2>
    <div class="grid grid--4">
      <% gallery.forEach(function (photo) { %>
        <div class="media-frame">
          <%- include('../partials/image', { media: photo, ratio: '1/1' }) %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section text-center reveal">
  <div class="container container--narrow">
    <a class="btn" href="/<%= lang %>/visit"><%= t('cta.visit_the_house') %></a>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="brand__wordmark" style="color:#fff;margin-bottom:0.75rem;">MINH QUANG</p>
      <p class="text-muted" style="max-width:40ch;">
        <%= t('meta.site_tagline') %><% if (settings && settings['founding_note_' + lang]) { %> - <%= settings['founding_note_' + lang] %><% } %>.
      </p>
      <%- include('./social-icons') %>
    </div>

    <div>
      <p class="footer-heading"><%= t('visit.address_label') %></p>
      <% if (settings && settings.address_line) { %>
        <p><%= settings.address_line %></p>
        <% if (settings.map_embed_url) { %>
          <a href="<%= settings.google_business_url || ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(settings.address_line)) %>" target="_blank" rel="noopener" data-track="click_map"><%= t('cta.get_directions') %></a>
        <% } %>
      <% } %>
    </div>

    <div>
      <p class="footer-heading"><%= t('visit.hours_label') %></p>
      <% if (settings && Array.isArray(settings.hours)) { %>
        <table class="hours-table" style="color:inherit;">
          <% settings.hours.forEach(function (h) { %>
            <tr>
              <td><%= lang === 'vi' ? h.day_vi : h.day_en %></td>
              <td>
                <% if (h.closed) { %><%= t('visit.closed') %><% } else { %>
                  <%= h.open %>–<%= h.close %><% if (h.open2) { %>, <%= h.open2 %>–<%= h.close2 %><% } %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </table>
      <% } %>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>&copy; <%= currentYear %> <%= companyName %>. <%= t('footer.rights') %></span>
    <span>
      <a href="/<%= lang %>/privacy"><%= t('footer.privacy') %></a>
      <% if (gaId) { %> · <button type="button" class="footer-link-btn" data-consent-open><%= t('consent.settings') %></button><% } %>
    </span>
  </div>
</footer>

<%- include('./consent') %>

<% if (currentPath.indexOf('/' + lang + '/visit') !== 0) { %>
<div class="mobile-cta">
  <a class="btn btn--accent" href="/<%= lang %>/visit#enquiry" data-track="click_book_bar"><%= t('cta.book_an_appointment') %></a>
  <% if (settings && settings.zalo_url) { %>
    <a class="btn btn--outline" href="<%= settings.zalo_url %>" target="_blank" rel="noopener" data-track="click_zalo">Zalo</a>
  <% } %>
</div>
<% } %>

<script src="<%= process.env.NODE_ENV === 'production' ? '/js/main.min.js' : '/js/main.js' %>?v=<%= assetVersion %>" defer></script>

<%
  // Locals expected: settings, t, lang (all already in scope wherever this
  // is included). Renders one circular icon per platform that has a URL
  // set in Admin > Settings > Contact & Social — blank fields are simply
  // skipped, so the row only ever shows what the house actually uses.
  var platforms = [
    { key: 'facebook', url: settings && settings.facebook_url, track: 'click_facebook', label: t('cta.follow_facebook') },
    { key: 'instagram', url: settings && settings.instagram_url, track: 'click_instagram', label: t('cta.follow_instagram') },
    { key: 'tiktok', url: settings && settings.tiktok_url, track: 'click_tiktok', label: t('cta.follow_tiktok') },
    { key: 'youtube', url: settings && settings.youtube_url, track: 'click_youtube', label: t('cta.follow_youtube') },
    { key: 'pinterest', url: settings && settings.pinterest_url, track: 'click_pinterest', label: t('cta.follow_pinterest') },
  ].filter(function (p) { return p.url; });
%>
<% if (platforms.length) { %>
  <div class="social-icons">
    <% platforms.forEach(function (p) { %>
      <a class="social-icon" href="<%= p.url %>" target="_blank" rel="noopener" aria-label="<%= p.label %>" title="<%= p.label %>" data-track="<%= p.track %>">
        <% if (p.key === 'facebook') { %>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15 8.5h2.5V5.6c-.43-.06-1.9-.18-3.6-.18-3.56 0-6 2.24-6 6.36V15H4.5v3.2H8V24h3.7v-5.8h3.4l.5-3.2h-3.9v-2.9c0-.93.26-1.6 1.3-1.6z"/></svg>
        <% } else if (p.key === 'instagram') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4.2"/>
            <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>
          </svg>
        <% } else if (p.key === 'tiktok') { %>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3h-3v12.4a2.6 2.6 0 1 1-2.1-2.55v-3.1a5.7 5.7 0 1 0 5.1 5.66V9.1c1.1.86 2.4 1.35 3.9 1.4V7.4c-2.1-.12-3.6-1.9-3.9-4.4z"/></svg>
        <% } else if (p.key === 'youtube') { %>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2" y="5.5" width="20" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="M10 9.3v5.4l5-2.7z" fill="currentColor"/>
          </svg>
        <% } else if (p.key === 'pinterest') { %>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.28 2 11.6c0 3.9 2.2 7.27 5.4 8.8-.07-.75-.14-1.9.03-2.72.15-.7 1-4.5 1-4.5s-.26-.53-.26-1.3c0-1.22.7-2.13 1.57-2.13.74 0 1.1.56 1.1 1.24 0 .75-.48 1.88-.73 2.93-.2.88.44 1.6 1.3 1.6 1.56 0 2.76-1.7 2.76-4.14 0-2.16-1.53-3.68-3.72-3.68-2.53 0-4.02 1.93-4.02 3.94 0 .78.29 1.62.66 2.07.07.09.08.17.06.26l-.25.99c-.04.17-.13.2-.3.12-1.14-.55-1.85-2.27-1.85-3.65 0-2.97 2.1-5.7 6.06-5.7 3.18 0 5.65 2.31 5.65 5.4 0 3.22-2 5.82-4.78 5.82-.93 0-1.81-.5-2.11-1.08l-.57 2.24c-.21.8-.77 1.8-1.15 2.42.86.27 1.77.42 2.72.42 5.52 0 10-4.28 10-9.6S17.52 2 12 2z"/></svg>
        <% } %>
      </a>
    <% }); %>
  </div>
<% } %>

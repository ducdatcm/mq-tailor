<%
  // Locals expected: headingKey (t() key used for the h1),
  // intro (the content.intro page_content row, or undefined),
  // wide (optional) — lets a short intro line run the full container width
  // instead of wrapping inside the narrow reading column,
  // ledeMax (optional, e.g. '85ch') — a middle ground for longer intros:
  // wider than the narrow column, but still capped so it stays readable.
  var _heading = t(headingKey);
  var _hasImage = intro && intro.media;
  var _ledeMax = typeof ledeMax !== 'undefined' && ledeMax ? ledeMax : (typeof wide !== 'undefined' && wide ? 'none' : null);
  var _bodyContainer = _ledeMax ? 'container' : 'container container--narrow';
  var _ledeStyle = _ledeMax ? 'margin-inline:auto;max-width:' + _ledeMax + ';' : 'margin-inline:auto;';
%>
<% if (_hasImage) { %>
  <section class="page-hero reveal">
    <div class="page-hero__media">
      <%- include('./image', { media: intro.media, alt: _heading, eager: true, sizesAttr: '100vw' }) %>
    </div>
    <div class="page-hero__content container container--narrow text-center">
      <h1><%= _heading %></h1>
    </div>
  </section>
  <% if (intro && intro['body_' + lang]) { %>
    <section class="section--tight <%= _bodyContainer %> text-center reveal">
      <% paragraphs(intro['body_' + lang]).forEach(function (para) { %>
        <p class="lede" style="<%= _ledeStyle %>"><%= para %></p>
      <% }); %>
    </section>
  <% } %>
<% } else { %>
  <section class="section section--alt reveal">
    <div class="<%= _bodyContainer %> text-center">
      <h1><%= _heading %></h1>
      <% paragraphs(intro && intro['body_' + lang]).forEach(function (para) { %>
        <p class="lede" style="<%= _ledeStyle %>"><%= para %></p>
      <% }); %>
    </div>
  </section>
<% } %>
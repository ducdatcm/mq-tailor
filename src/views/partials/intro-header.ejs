<%
  // Locals expected: headingKey (t() key used for both the eyebrow and h1),
  // intro (the content.intro page_content row, or undefined).
  var _heading = t(headingKey);
  var _hasImage = intro && intro.media;
%>
<% if (_hasImage) { %>
  <div class="media-frame">
    <%- include('./image', { media: intro.media, alt: _heading, ratio: '21/9', eager: true, sizesAttr: '100vw' }) %>
  </div>
<% } %>
<section class="<%= _hasImage ? 'section--tight' : 'section' %> container container--narrow reveal">
  <span class="eyebrow"><%= _heading %></span>
  <h1><%= _heading %></h1>
  <p class="lede"><%= intro ? intro['body_' + lang] : '' %></p>
</section>

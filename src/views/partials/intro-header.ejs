<%
  // Locals expected: headingKey (t() key used for both the eyebrow and h1),
  // intro (the content.intro page_content row, or undefined).
  var _heading = t(headingKey);
  var _hasImage = intro && intro.media;
%>
<% if (_hasImage) { %>
  <section class="page-hero reveal">
    <div class="page-hero__media">
      <%- include('./image', { media: intro.media, alt: _heading, eager: true, sizesAttr: '100vw' }) %>
    </div>
    <div class="page-hero__content container container--narrow">
      <span class="eyebrow"><%= _heading %></span>
      <h1><%= _heading %></h1>
    </div>
  </section>
  <% if (intro && intro['body_' + lang]) { %>
    <section class="section--tight container container--narrow reveal">
      <p class="lede"><%= intro['body_' + lang] %></p>
    </section>
  <% } %>
<% } else { %>
  <section class="section container container--narrow reveal">
    <span class="eyebrow"><%= _heading %></span>
    <h1><%= _heading %></h1>
    <p class="lede"><%= intro ? intro['body_' + lang] : '' %></p>
  </section>
<% } %>

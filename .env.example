# Copy this file to .env on the server (or locally) and fill in real values.
# Never commit the real .env file.

# --- App ---
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.com

# --- Session ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- MySQL (create this database + user in Hostinger hPanel first) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# --- One-time admin seed (run `npm run seed:admin`, then remove these two lines) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me-before-seeding

# --- Outgoing mail for enquiry notifications (optional — leave blank to skip email relay) ---
# Example for a Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Minh Quang Tailoring House" <no-reply@your-domain.com>
ENQUIRY_NOTIFY_TO=minhquanghotline@gmail.com

# --- Analytics (optional — leave blank to disable) ---
GA_MEASUREMENT_ID=
